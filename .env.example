# Copy to .env and fill in. NEVER commit .env.

# ---- Safety ----------------------------------------------------------------
# Master switch. "true" = prepare everything but never click submit.
# Keep this true until you have reviewed many dry-run screenshots.
DRY_RUN=true

# Hard stop. Not a warning.
MAX_APPLICATIONS_PER_DAY=10

# Create this file to halt all submission immediately.
KILL_SWITCH_FILE=./STOP

# ---- AI (needed from Phase 3) ----------------------------------------------
# Provider is chosen by whichever key is set. If both are set, AI_PROVIDER
# decides; leave it blank to auto-detect (gemini preferred, it has a free tier).
AI_PROVIDER=

# Google AI Studio -> https://aistudio.google.com/apikey
# Free tier is enough for this bot: ~15 requests/min, ~1500/day.
# Note: free-tier prompts may be used by Google for model training.
GEMINI_API_KEY=

# OpenAI -> https://platform.openai.com/api-keys  (paid, optional alternative)
OPENAI_API_KEY=

# Model names must match the chosen provider. Verified available Sep 2026:
#   gemini: gemini-3.1-flash-lite   / gemini-3.6-flash
#   openai: gpt-4o-mini             / gpt-4o
# Note: gemini-2.x models are closed to new API keys, and the Pro tier
# (gemini-*-pro) returns 429 on the free tier. flash-lite is the workhorse.
AI_MODEL_CHEAP=gemini-3.1-flash-lite
AI_MODEL_SMART=gemini-3.6-flash

# Hard stop, not a warning. Free-tier Gemini costs nothing, so this only
# bites if you switch to a paid provider.
AI_MONTHLY_BUDGET_USD=20

# Pacing between AI calls, to stay inside free-tier rate limits.
# 15 req/min -> 4000ms is a safe floor.
AI_REQUEST_DELAY_MS=4500

# ---- Notifications (needed from Phase 4) -----------------------------------
# Telegram: message @BotFather to create a bot, @userinfobot for your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Dashboard (needed from Phase 2) ---------------------------------------
DASHBOARD_PORT=3000

# ---- Paths -----------------------------------------------------------------
DATABASE_PATH=./data/jobs.db
SCREENSHOT_DIR=./screenshots
LOG_DIR=./logs

# ---- Logging ---------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info

# ---- Browser (Phase 5/6) ---------------------------------------------------
# Set if the default browser cache is not writable:
#   PLAYWRIGHT_BROWSERS_PATH=./.playwright
# then run: PLAYWRIGHT_BROWSERS_PATH=./.playwright npx playwright install chromium
PLAYWRIGHT_BROWSERS_PATH=
